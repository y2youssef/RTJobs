# Copy to .env and fill credentials/channel IDs. Never commit .env.
TELEGRAM_TOKEN=
TELEGRAM_CHAT_ID=
TELEGRAM_FAILURE_CHAT_ID=
TELEGRAM_API_BASE_URL=https://api.telegram.org
# Map every canonical family to a unique channel ID. Values intentionally blank.
TELEGRAM_CHANNELS_JSON='{"sales_business_development":"","accounting_finance_banking":"","customer_service_call_center":"","human_resources_recruitment":"","marketing_ecommerce":"","software_engineering":"","data_ai_analytics":"","it_cloud_cybersecurity":"","engineering_construction":"","industrial_manufacturing_maintenance":"","supply_chain_procurement_logistics":"","operations_projects_quality":"","administration_office_support":"","design_creative":"","content_media_communications":"","healthcare_medical":"","education_training":"","legal_compliance_risk":"","product_business_analysis":"","hospitality_tourism_food_service":"","retail_store_operations":"","safety_security_facilities":"","science_research":"","consulting_strategy":"","general_management":"","other":""}'

LINKEDIN_EMAIL=
LINKEDIN_PASSWORD=
INDEED_EMAIL=
OPENROUTER_API_KEY=
OPENROUTER_BASE_URL=https://openrouter.ai/api/v1

# Both must be explicitly enabled for production classification and delivery.
ENRICHMENT_ENABLED=false
CLASSIFIED_DELIVERY_ENABLED=false
CLASSIFIER_MODEL=openai/gpt-6-luna
CLASSIFIER_DAILY_BUDGET_USD=1
CLASSIFIER_TIMEOUT_SECONDS=300
CLASSIFIER_MAX_OUTPUT_TOKENS=2200  # allowance per job, scaled for the whole batch
CLASSIFIER_MAX_INPUT_CHARS=0      # preserve full relevant source input
CLASSIFIER_ALERT_AFTER_FAILURES=3
CLASSIFIER_RETRY_MAX_SECONDS=3600
CLASSIFIER_VALIDATION_RETRY_MAX_SECONDS=120  # fast output correction (30s, 60s) until ALERT_AFTER_FAILURES, then normal backoff
ENRICHMENT_POLL_SECONDS=30  # fallback for missed notifications and retries
NOTIFY_BATCH_SIZE=50
NOTIFY_PER_CHANNEL_LIMIT=20
DELIVERY_POLL_SECONDS=2    # fallback; saved results notify delivery immediately

# Local independent monitoring; external heartbeat can be added later.
PIPELINE_MONITOR_INTERVAL_SECONDS=60
PIPELINE_QUEUE_STALE_SECONDS=900
PIPELINE_WORKER_STALE_SECONDS=900
PIPELINE_SCRAPER_STALE_SECONDS=1800
PIPELINE_DELIVERY_ALERT_ATTEMPTS=3
PIPELINE_ALERT_RETRY_SECONDS=300
PIPELINE_STARTUP_GRACE_SECONDS=180

# Reposts: same job ID with a listing this many hours newer; re-sent after N days.
REPOST_MIN_GAP_HOURS=24
REPOST_REDELIVER_AFTER_DAYS=7
# Scrape cadence for ofelia + overrun catch-up (must divide 60).
SCRAPE_INTERVAL_MINUTES=3
LINKEDIN_ENABLED=true
WUZZUF_ENABLED=true
INDEED_ENABLED=false
NAUKRIGULF_ENABLED=false           # Akamai-protected; enable after a supervised first run
# NAUKRIGULF_SEARCH_URL=https://www.naukrigulf.com/jobs-in-egypt?freshness=1&xz=1_3_5
HEADLESS=false
DATA_DIR=.
TZ=Africa/Cairo
CHROME_DEBUG_PORT=9222             # LinkedIn; Wuzzuf +1 (9223), Indeed +2 (9224)
BOARDS_PARALLEL=true               # boards run concurrently inside one cycle
BOARD_TIME_BUDGET_SECONDS=300      # per board, excluding waits for you (2FA / emailed code)
CHECKPOINT_WAIT_SECONDS=600
MAX_LOGIN_RETRIES=3
LINKEDIN_NAVIGATION_RETRY_DELAY_SECONDS=3
LINKEDIN_NAVIGATION_TIMEOUT_SECONDS=20
LINKEDIN_SEARCH_RECOVERY_ATTEMPTS=1
LINKEDIN_SEARCH_RECOVERY_TIMEOUT_SECONDS=30
LINKEDIN_DETAIL_RECOVERY_TIMEOUT_SECONDS=20
LINKEDIN_SLOW_ASSET_WAIT_SECONDS=90   # one longer same-page wait while LinkedIn's app bundle downloads
INDEED_CODE_WAIT_SECONDS=600
MAX_SNAPSHOTS_PER_KIND=20
KILL_CHROME_ON_START=false
# auto = --no-sandbox only inside Docker. Set true on hosts that block
# unprivileged user namespaces (Chrome: "Failed to move to new namespace").
CHROME_NO_SANDBOX=auto
HEALTHCHECK_URL=
LOG_LEVEL=INFO
# Optional: LOG_FILE= to disable file logging; Docker uses /data/logs/.
